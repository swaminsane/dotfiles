#!/bin/bash

SCRIPTS_DIR="$HOME/.local/bin/menu/music"
source "$SCRIPTS_DIR/lib/common"

# Click handling
case "$BLOCK_BUTTON" in
    1) setsid -f "$SCRIPTS_DIR/musicmenu" & ;;  # left click → menu
    2) smart_play_pause ;;                               # middle → play/pause
    3) notify-send "Music" "Left: menu | Middle: play/pause" ;;
esac

status="$(get_status)"

# If nothing playing → output nothing
[ -z "$status" ] && exit 0

printf "%s\n" "$status"
