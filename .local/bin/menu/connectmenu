#!/usr/bin/env bash
# =============================================================================
# network-menu — Wi‑Fi & Bluetooth controller (dmenu‑frontend)
#
# Usage:
#   network-menu                        → full interactive menu
#   network-menu --wifi                 → Wi‑Fi submenu only
#   network-menu --bluetooth            → Bluetooth submenu only
#   network-menu --wifi-toggle          → toggle Wi‑Fi radio directly
#   network-menu --wifi-connect <ssid>  → connect to <ssid> (may ask password)
#   network-menu --wifi-disconnect      → disconnect current Wi‑Fi
#   network-menu --bt-toggle            → toggle BT radio
#   network-menu --bt-connect <dev>     → connect to device <dev>
#   network-menu --bt-disconnect <dev>  → disconnect device <dev>
#
# Dependencies: nmcli, bluetoothctl, rfkill, notify-send, dmenu
# =============================================================================

export PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH

set -o pipefail

# ---------------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------------
DMENU_LINES=12
DMENU_PROMPT_ARGS=(-i)
NOTIFY_TIMEOUT=4000

# Colours for dmenu (optional – set empty to disable)
# DMENU_COLORS="-nb '#2e3440' -nf '#d8dee9' -sb '#88c0d0' -sf '#2e3440'"
DMENU_COLORS=""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_dmenu() {
    local prompt="$1"; shift
    dmenu ${DMENU_COLORS:+"$DMENU_COLORS"} "${DMENU_PROMPT_ARGS[@]}" -p "$prompt" "$@"
}

_notify() {
    notify-send --expire-time="$NOTIFY_TIMEOUT" "$1" "${2:-}" 2>/dev/null || true
}

_require() {
    command -v "$1" &>/dev/null || {
        _notify "Missing dependency" "'$1' not found — install it first"
        exit 1
    }
}

# ---------------------------------------------------------------------------
# Pre‑flight checks
# ---------------------------------------------------------------------------
_require nmcli
_require bluetoothctl
_require rfkill
_require notify-send
_require dmenu

# =============================================================================
# WI‑FI HELPERS
# =============================================================================

# Returns 0 if wifi radio is on
wifi_is_on() {
    [[ $(nmcli radio wifi 2>/dev/null) == "enabled" ]]
}

# Get current connected SSID (empty if none)
wifi_connected_ssid() {
    nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '/^yes/ {print $2; exit}'
}

# Get signal strength of connected network (0-100)
wifi_signal() {
    nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | awk -F: '/^yes/ {print $2; exit}'
}

# Generate a list of "SSID (signal%)" – deduplicated, best signal kept
wifi_scan_list() {
    nmcli -g SSID,SIGNAL dev wifi list 2>/dev/null \
        | awk -F: '
            NF>=2 {
                sig = $NF
                ssid = ""
                for (i=1; i<NF; i++) ssid = ssid (i==1?"":":") $i
                if (ssid != "" && ssid != "--")
                    print sig " " ssid
            }
        ' \
        | sort -rn \
        | awk '!seen[$2]++ { printf "%s %s\n", $1, $2 }'
}

# Get all saved Wi‑Fi profile names
wifi_saved_profiles() {
    nmcli -g NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2=="802-11-wireless" { print $1 }'
}

# =============================================================================
# WI‑FI ACTIONS
# =============================================================================

# Toggle radio on/off
action_wifi_toggle() {
    if wifi_is_on; then
        nmcli radio wifi off || { _notify "Wi‑Fi" "Failed to turn off"; return 1; }
        _notify "Wi‑Fi" "Radio disabled"
    else
        nmcli radio wifi on || { _notify "Wi‑Fi" "Failed to turn on"; return 1; }
        _notify "Wi‑Fi" "Radio enabled"
    fi
}

# Connect to a specific SSID (will prompt for password if needed)
action_wifi_connect() {
    local target_ssid="$1"
    [[ -z "$target_ssid" ]] && { _notify "Wi‑Fi" "No SSID given"; return 1; }

    if ! wifi_is_on; then
        _notify "Wi‑Fi" "Radio is off — turn it on first"
        return 1
    fi

    # Check if it's a saved profile
    if wifi_saved_profiles | grep -qxF "$target_ssid"; then
        _notify "Wi‑Fi" "Connecting to $target_ssid…"
        if nmcli connection up id "$target_ssid" 2>/dev/null; then
            _notify "Wi‑Fi" "Connected to $target_ssid"
        else
            _notify "Wi‑Fi" "Connection failed — try 'Forget & Reconnect'"
        fi
        return
    fi

    # Determine if it's an open network
    local security
    security=$(nmcli -t -f SSID,SECURITY dev wifi list 2>/dev/null \
        | awk -F: -v target="$target_ssid" '$1 == target {print $2; exit}')

    if [[ "$security" == "open" || "$security" == "--" || -z "$security" ]]; then
        _notify "Wi‑Fi" "Connecting to $target_ssid…"
        if nmcli dev wifi connect "$target_ssid" 2>/dev/null; then
            _notify "Wi‑Fi" "Connected to $target_ssid"
        else
            _notify "Wi‑Fi" "Failed to connect to $target_ssid"
        fi
    else
        local password
        password=$(_dmenu "Password for '$target_ssid':" < /dev/null)
        [[ -z "$password" ]] && return 1

        _notify "Wi‑Fi" "Connecting to $target_ssid…"
        if nmcli dev wifi connect "$target_ssid" password "$password" 2>/dev/null; then
            _notify "Wi‑Fi" "Connected to $target_ssid"
        else
            _notify "Wi‑Fi" "Wrong password or connection failed"
        fi
    fi
}

# Disconnect current Wi‑Fi
action_wifi_disconnect() {
    local conn
    conn=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
        | awk -F: '$2=="802-11-wireless" { print $1; exit }')

    if [[ -n "$conn" ]]; then
        nmcli connection down "$conn" 2>/dev/null \
            && _notify "Wi‑Fi" "Disconnected from $conn" \
            || _notify "Wi‑Fi" "Failed to disconnect $conn"
    else
        local dev
        dev=$(nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null \
            | awk -F: '$2=="wifi" && $3=="connected" { print $1; exit }')
        if [[ -n "$dev" ]]; then
            nmcli device disconnect "$dev" 2>/dev/null \
                && _notify "Wi‑Fi" "Disconnected ($dev)" \
                || _notify "Wi‑Fi" "Failed to disconnect $dev"
        else
            _notify "Wi‑Fi" "No active Wi‑Fi connection"
        fi
    fi
}

# =============================================================================
# INTERACTIVE WI‑FI MENU
# =============================================================================
interactive_wifi() {
    while true; do
        local opt
        opt=$(printf "Connect\nDisconnect\nTurn On\nTurn Off\nStatus\nSaved Networks\nForget Network\nBack" \
            | _dmenu "Wi‑Fi:")
        [[ -z "$opt" || "$opt" == "Back" ]] && return 0

        case "$opt" in
        "Turn On")
            nmcli radio wifi on 2>/dev/null \
                && _notify "Wi‑Fi" "Radio enabled" \
                || _notify "Wi‑Fi" "Failed to enable radio"
            ;;

        "Turn Off")
            nmcli radio wifi off 2>/dev/null \
                && _notify "Wi‑Fi" "Radio disabled" \
                || _notify "Wi‑Fi" "Failed to disable radio"
            ;;

        "Connect")
            if ! wifi_is_on; then
                _notify "Wi‑Fi" "Radio is off — turn it on first"
                continue
            fi

            # Rescan
            nmcli dev wifi rescan 2>/dev/null || true
            sleep 1.5

            local list
            list=$(wifi_scan_list)
            if [[ -z "$list" ]]; then
                _notify "Wi‑Fi" "No networks found"
                continue
            fi

            local saved
            saved=$(wifi_saved_profiles)

            # Build display: [saved] SSID (sig%)
            local display
            display=$(echo "$list" | while read -r sig ssid; do
                if echo "$saved" | grep -qxF "$ssid"; then
                    printf "[saved] %-36s %s%%\n" "$ssid" "$sig"
                else
                    printf "        %-36s %s%%\n" "$ssid" "$sig"
                fi
            done)

            local selected
            selected=$(echo "$display" | _dmenu "Select network:" -l "$DMENU_LINES")
            [[ -z "$selected" ]] && continue

            local ssid
            ssid=$(echo "$selected" \
                | sed 's/^\[saved\] //; s/^        //' \
                | sed 's/[[:space:]]*[0-9]\+%[[:space:]]*$//' \
                | sed 's/[[:space:]]*$//')

            [[ -z "$ssid" ]] && continue

            # Saved profile? Offer reconnect or forget
            if echo "$saved" | grep -qxF "$ssid"; then
                local action
                action=$(printf "Reconnect\nForget & Reconnect\nCancel" \
                    | _dmenu "'$ssid':")
                [[ -z "$action" || "$action" == "Cancel" ]] && continue

                if [[ "$action" == "Forget & Reconnect" ]]; then
                    nmcli connection delete "$ssid" 2>/dev/null || true
                    _notify "Wi‑Fi" "Forgotten $ssid — entering new password"
                    action_wifi_connect "$ssid"
                else
                    action_wifi_connect "$ssid"
                fi
            else
                action_wifi_connect "$ssid"
            fi
            ;;

        "Disconnect")
            action_wifi_disconnect
            ;;

        "Status")
            local ssid signal ip
            ssid=$(wifi_connected_ssid)
            if [[ -n "$ssid" ]]; then
                signal=$(wifi_signal)
                ip=$(nmcli -t -f IP4.ADDRESS dev show 2>/dev/null | awk -F: 'NR==1 { print $2 }')
                printf "%s  sig:%s%%  %s" "$ssid" "$signal" "$ip" \
                    | _dmenu "Wi‑Fi Status:" -l 1
            else
                printf "Not connected" | _dmenu "Wi‑Fi Status:" -l 1
            fi
            ;;

        "Saved Networks")
            local saved_list
            saved_list=$(wifi_saved_profiles)
            if [[ -z "$saved_list" ]]; then
                printf "No saved networks" | _dmenu "Saved:" -l 1
            else
                local chosen
                chosen=$(echo "$saved_list" | _dmenu "Saved networks:" -l "$DMENU_LINES")
                [[ -z "$chosen" ]] && continue
                local act
                act=$(printf "Connect\nForget\nCancel" | _dmenu "'$chosen':")
                case "$act" in
                "Connect") action_wifi_connect "$chosen" ;;
                "Forget")
                    nmcli connection delete "$chosen" 2>/dev/null \
                        && _notify "Wi‑Fi" "Forgotten $chosen" \
                        || _notify "Wi‑Fi" "Could not forget $chosen"
                    ;;
                esac
            fi
            ;;

        "Forget Network")
            local saved_list
            saved_list=$(wifi_saved_profiles)
            if [[ -z "$saved_list" ]]; then
                printf "No saved networks" | _dmenu "Saved:" -l 1
            else
                local chosen
                chosen=$(echo "$saved_list" | _dmenu "Forget network:" -l "$DMENU_LINES")
                [[ -z "$chosen" ]] && continue
                nmcli connection delete "$chosen" 2>/dev/null \
                    && _notify "Wi‑Fi" "Forgotten $chosen" \
                    || _notify "Wi‑Fi" "Could not forget $chosen"
            fi
            ;;
        esac
    done
}

# =============================================================================
# BLUETOOTH (robust)
# =============================================================================

bt_is_on() {
    bluetoothctl show 2>/dev/null | grep -q "Powered: yes"
}

action_bt_toggle() {
    if bt_is_on; then
        rfkill block bluetooth 2>/dev/null
        sleep 0.3
        if bt_is_on; then
            _notify "Bluetooth" "Failed to disable"
        else
            _notify "Bluetooth" "Turned OFF"
        fi
    else
        rfkill unblock bluetooth 2>/dev/null
        sleep 0.3
        if bt_is_on; then
            _notify "Bluetooth" "Turned ON"
        else
            _notify "Bluetooth" "Failed to enable"
        fi
    fi
}

action_bt_connect() {
    local target="$1"
    [[ -z "$target" ]] && { _notify "Bluetooth" "No device specified"; return 1; }

    # Extract the MAC address (first column of a bluetoothctl output line)
    local mac
    mac=$(echo "$target" | awk '{print $1}')
    if [[ -z "$mac" ]]; then
        _notify "Bluetooth" "Invalid device"
        return 1
    fi

    if bluetoothctl connect "$mac" 2>/dev/null; then
        _notify "Bluetooth" "Connected to $target"
    else
        _notify "Bluetooth" "Failed to connect to $target"
    fi
}

action_bt_disconnect() {
    local target="$1"
    [[ -z "$target" ]] && { _notify "Bluetooth" "No device specified"; return 1; }

    local mac
    mac=$(echo "$target" | awk '{print $1}')
    if [[ -z "$mac" ]]; then
        _notify "Bluetooth" "Invalid device"
        return 1
    fi

    if bluetoothctl disconnect "$mac" 2>/dev/null; then
        _notify "Bluetooth" "Disconnected from $target"
    else
        _notify "Bluetooth" "Failed to disconnect $target"
    fi
}

interactive_bluetooth() {
    while true; do
        local opt
        opt=$(printf "Connect\nTurn On\nTurn Off\nDisconnect\nStatus\nBack" \
            | _dmenu "Bluetooth:")
        [[ -z "$opt" || "$opt" == "Back" ]] && return 0

        case "$opt" in
        "Turn On")
            if ! bt_is_on; then
                action_bt_toggle
            else
                _notify "Bluetooth" "Already on"
            fi
            ;;

        "Turn Off")
            if bt_is_on; then
                action_bt_toggle
            else
                _notify "Bluetooth" "Already off"
            fi
            ;;

        "Connect")
            if ! bt_is_on; then
                _notify "Bluetooth" "Bluetooth is off — turn it on first"
                continue
            fi

            local devices
            devices=$(bluetoothctl devices 2>/dev/null | awk '{ $1=""; print $0 }' | sed 's/^ //')
            if [[ -z "$devices" ]]; then
                printf "No paired devices found" | _dmenu "BT Devices:" -l 1
                continue
            fi

            local chosen
            chosen=$(echo "$devices" | _dmenu "Connect to:" -l 8)
            [[ -z "$chosen" ]] && continue
            action_bt_connect "$chosen"
            ;;

        "Disconnect")
            local connected
            connected=$(bluetoothctl devices Connected 2>/dev/null | awk '{ $1=""; print $0 }' | sed 's/^ //')
            if [[ -z "$connected" ]]; then
                printf "No devices connected" | _dmenu "BT Connected:" -l 1
                continue
            fi

            local chosen
            chosen=$(echo "$connected" | _dmenu "Disconnect:" -l 8)
            [[ -z "$chosen" ]] && continue
            action_bt_disconnect "$chosen"
            ;;

        "Status")
            local connected
            connected=$(bluetoothctl devices Connected 2>/dev/null | awk '{ $1=""; print $0 }' | sed 's/^ //')
            if [[ -n "$connected" ]]; then
                echo "$connected" | _dmenu "BT Connected:" -l 8
            else
                printf "No devices connected" | _dmenu "Bluetooth Status:" -l 1
            fi
            ;;
        esac
    done
}

# =============================================================================
# COMMAND‑LINE DISPATCH (for panel modules)
# =============================================================================
case "${1:-}" in
    # Direct actions
    --wifi-toggle)       action_wifi_toggle ;;
    --wifi-connect)      action_wifi_connect "${2:-}" ;;
    --wifi-disconnect)   action_wifi_disconnect ;;
    --bt-toggle)         action_bt_toggle ;;
    --bt-connect)        action_bt_connect "${2:-}" ;;
    --bt-disconnect)     action_bt_disconnect "${2:-}" ;;

    # Submenu shortcuts
    --wifi)              interactive_wifi ;;
    --bluetooth)         interactive_bluetooth ;;

    # Default full menu
    *)
        CHOICE=$(printf "Wi‑Fi\nBluetooth" | _dmenu "Network:")
        case "$CHOICE" in
            "Wi‑Fi")     interactive_wifi ;;
            "Bluetooth") interactive_bluetooth ;;
        esac
        ;;
esac

exit 0
