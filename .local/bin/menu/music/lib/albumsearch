#!/bin/bash
source "$HOME/.local/bin/menu/music/lib/common"

YT_HISTORY_FILE="$HOME/.local/share/music-menu/yt_history"
[ -f "$YT_HISTORY_FILE" ] || touch "$YT_HISTORY_FILE"

play_url() {
    local url="$1"
    local title="$2"
    kill_pid_file "$YT_PID_FILE"
    kill_pid_file "$RADIO_PID_FILE"
    /usr/bin/mpc pause 2>/dev/null
    notify-send "Album" "Playing: $title"
    mpv --no-video --really-quiet \
        --ytdl-format="bestaudio" \
        --input-ipc-server="$YT_SOCKET" \
        "$url" &
    echo $! > "$YT_PID_FILE"
    sed -i "/^#EXTINF:-1,$title$/{N;d;}" "$YT_HISTORY_FILE"
    printf "#EXTINF:-1,%s\n%s\n" "$title" "$url" | \
        cat - "$YT_HISTORY_FILE" > /tmp/yt_hist_tmp && \
        mv /tmp/yt_hist_tmp "$YT_HISTORY_FILE"
}

play_yt_search() {
    local query="$1"
    local title="$2"
    notify-send "Album" "Finding: $title..."
    url=$(yt-dlp "ytsearch1:$query" \
        --print "%(webpage_url)s" \
        --no-playlist 2>/dev/null | head -n1)
    if [ -z "$url" ]; then
        notify-send "Album" "Could not find: $title"
        return
    fi
    play_url "$url" "$title"
}

# Step 1 — artist name
artist=$(echo "" | dmenu -p "Artist name")
[ -z "$artist" ] && exit

# Step 2 — optional album
album=$(echo "" | dmenu -p "Album name (optional)")

# Step 3 — search Deezer
notify-send "Album Search" "Searching Deezer..."

if [ -n "$album" ]; then
    search_term="$artist $album"
else
    search_term="$artist"
fi

encoded=$(python3 -c "import urllib.parse; print(urllib.parse.quote('''$search_term'''))")

deezer_response=$(curl -s \
    "https://api.deezer.com/search/album?q=${encoded}&limit=15")

if [ -z "$deezer_response" ]; then
    notify-send "Album Search" "No response from Deezer."
    exit
fi

# Step 4 — parse albums into "Artist — Album (Year)\tID"
albums=$(python3 -c "
import sys, json

data = json.loads('''$deezer_response''' if False else open('/dev/stdin').read())
seen = set()
for a in data.get('data', []):
    title   = a.get('title', '')
    artist  = a.get('artist', {}).get('name', '')
    year    = a.get('release_date', '')[:4]
    aid     = a.get('id', '')
    nb      = a.get('nb_tracks', '')
    label   = f'{artist} — {title} ({year}) [{nb} tracks]'
    if label not in seen:
        seen.add(label)
        print(f'{label}\t{aid}')
" <<< "$deezer_response")

if [ -z "$albums" ]; then
    notify-send "Album Search" "No albums found for: $search_term"
    exit
fi

# Step 5 — pick album
selected=$(echo "$albums" | awk -F'\t' '{print $1}' | \
    dmenu -i -l 15 -p "Select album")
[ -z "$selected" ] && exit

album_id=$(echo "$albums" | grep -F "$selected" | \
    awk -F'\t' '{print $2}' | head -n1)
[ -z "$album_id" ] && exit

# Step 6 — fetch tracklist from Deezer
notify-send "Album Search" "Fetching tracklist..."

tracks_response=$(curl -s "https://api.deezer.com/album/${album_id}/tracks")

tracks=$(python3 -c "
import sys, json
data = json.loads(open('/dev/stdin').read())
for i, t in enumerate(data.get('data', []), 1):
    title = t.get('title', '')
    print(f'{i}. {title}')
" <<< "$tracks_response")

if [ -z "$tracks" ]; then
    notify-send "Album Search" "Could not fetch tracklist."
    exit
fi

# Step 7 — pick track or play all
album_name=$(echo "$selected" | awk -F' — ' '{print $2}' | sed 's/ ([0-9]*.*//')
artist_name=$(echo "$selected" | awk -F' — ' '{print $1}')

track_choice=$(printf "▶ Play All\n$tracks" | \
    dmenu -i -l 20 -p "$artist_name — $album_name")
[ -z "$track_choice" ] && exit

if [ "$track_choice" = "▶ Play All" ]; then
    notify-send "Album" "Building playlist for $album_name..."

    playlist_file="/tmp/album_playlist.txt"
    > "$playlist_file"

    total=$(echo "$tracks" | wc -l)
    count=0

    while IFS= read -r track; do
        track_title=$(echo "$track" | sed 's/^[0-9]*\. //')
        count=$((count + 1))
        notify-send "Album" "Resolving track $count/$total: $track_title"
        url=$(yt-dlp "ytsearch1:$artist_name $album_name $track_title" \
            --print "%(webpage_url)s" \
            --no-playlist 2>/dev/null | head -n1)
        [ -n "$url" ] && echo "$url" >> "$playlist_file"
    done <<< "$tracks"

    if [ ! -s "$playlist_file" ]; then
        notify-send "Album" "Could not resolve any tracks."
        exit
    fi

    kill_pid_file "$YT_PID_FILE"
    kill_pid_file "$RADIO_PID_FILE"
    /usr/bin/mpc pause 2>/dev/null

    mpv --no-video --really-quiet \
        --ytdl-format="bestaudio" \
        --input-ipc-server="$YT_SOCKET" \
        --playlist="$playlist_file" &
    echo $! > "$YT_PID_FILE"
    notify-send "Album" "Now playing $album_name — $total tracks queued"
else
    track_title=$(echo "$track_choice" | sed 's/^[0-9]*\. //')
    play_yt_search "$artist_name $album_name $track_title" "$track_title"
fi
