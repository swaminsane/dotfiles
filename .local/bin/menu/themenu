# ── two-level menu ───────────────────────────────────────────────────────────

CATEGORY=$(printf "named\nmuted\nminimal\nlight" | dmenu -p "category:")

case "$CATEGORY" in
  named)
    CHOICE=$(printf "doom-one\ncatppuccin\ntokyonight\neverforest\nspacemacs\ngruvbox\nnord\ndracula\nrose-pine\nkanagawa" \
      | dmenu -p "theme [named]:")
    ;;
  muted)
    CHOICE=$(printf "blush\nember\nmoss\ndusk\nshakti\nhermit\ncoastal\ndesert\nshinto" \
      | dmenu -p "theme [muted]:")
    ;;
  minimal)
    CHOICE=$(printf "slate\nmono\nink\ngray_dark" \
      | dmenu -p "theme [minimal]:")
    ;;
  light)
    CHOICE=$(printf "paper\ngray_light\nlight_cool\nlight_nature\ncatppuccin_latte\neverforest_light" \
      | dmenu -p "theme [light]:")
    ;;
  *)
    exit 1
    ;;
esac

[ -z "$CHOICE" ] && exit 1

case "$CHOICE" in
  # named
  doom-one)         theme_doom_one        > "$THEME_FILE" ;;
  catppuccin)       theme_catppuccin      > "$THEME_FILE" ;;
  tokyonight)       theme_tokyonight      > "$THEME_FILE" ;;
  everforest)       theme_everforest      > "$THEME_FILE" ;;
  spacemacs)        theme_spacemacs       > "$THEME_FILE" ;;
  gruvbox)          theme_gruvbox         > "$THEME_FILE" ;;
  nord)             theme_nord            > "$THEME_FILE" ;;
  dracula)          theme_dracula         > "$THEME_FILE" ;;
  rose-pine)        theme_rose_pine       > "$THEME_FILE" ;;
  kanagawa)         theme_kanagawa        > "$THEME_FILE" ;;
  # muted
  blush)            theme_blush           > "$THEME_FILE" ;;
  ember)            theme_ember           > "$THEME_FILE" ;;
  moss)             theme_moss            > "$THEME_FILE" ;;
  dusk)             theme_dusk            > "$THEME_FILE" ;;
  shakti)           theme_shakti          > "$THEME_FILE" ;;
  hermit)           theme_hermit          > "$THEME_FILE" ;;
  coastal)          theme_coastal         > "$THEME_FILE" ;;
  desert)           theme_desert          > "$THEME_FILE" ;;
  shinto)           theme_shinto          > "$THEME_FILE" ;;
  # minimal
  slate)            theme_slate           > "$THEME_FILE" ;;
  mono)             theme_mono            > "$THEME_FILE" ;;
  ink)              theme_ink             > "$THEME_FILE" ;;
  gray_dark)        theme_gray_dark       > "$THEME_FILE" ;;
  # light
  paper)            theme_paper           > "$THEME_FILE" ;;
  gray_light)       theme_gray_light      > "$THEME_FILE" ;;
  light_cool)       theme_light_cool      > "$THEME_FILE" ;;
  light_nature)     theme_light_nature    > "$THEME_FILE" ;;
  catppuccin_latte) theme_catppuccin_latte > "$THEME_FILE" ;;
  everforest_light) theme_everforest_light > "$THEME_FILE" ;;
  *)
    exit 1
    ;;
esac

echo "Applying theme: $CHOICE"

# ── recompile ────────────────────────────────────────────────────────────────
for dir in "$ST_DIR" "$DWM_DIR" "$DMENU_DIR" "$TABBED_DIR"; do
  name=$(basename $dir)
  echo "Building $name..."
  cd "$dir" && sudo make clean install
  notify-send "built $name"
done

echo "Done. Restart dwm to apply :D"
notify-send "theme: $CHOICE" "Done. Restart dwm to apply."

# Reload Emacs theme (if running)
emacsclient -e "(suckless-reload-theme)" >/dev/null 2>&1
