# ── pick theme ───────────────────────────────────────────────────────────────
CHOICE=$(printf "blush\nslate\nember\nmoss\ndusk\nmono\nshakti\nhermit\ncoastal\ndesert\nshinto\nink\ngray_dark\ngray_light\npaper\nlight_cool\nlight_nature" | dmenu -p "theme:")

case "$CHOICE" in
  blush) theme_blush > "$THEME_FILE" ;;
  slate)    theme_slate    > "$THEME_FILE" ;;
  ember)    theme_ember    > "$THEME_FILE" ;;
  moss)     theme_moss     > "$THEME_FILE" ;;
  dusk)     theme_dusk     > "$THEME_FILE" ;;
  mono)     theme_mono     > "$THEME_FILE" ;;
  shakti)   theme_shakti   > "$THEME_FILE" ;;
  hermit)   theme_hermit   > "$THEME_FILE" ;;
  coastal)   theme_coastal   > "$THEME_FILE" ;;
  desert)   theme_desert   > "$THEME_FILE" ;;
  shinto)   theme_shinto   > "$THEME_FILE" ;;
  ink)   theme_ink   > "$THEME_FILE" ;;
  gray_dark)     theme_gray_dark     > "$THEME_FILE" ;;
  gray_light)    theme_gray_light    > "$THEME_FILE" ;;
  paper)         theme_paper         > "$THEME_FILE" ;;
  light_cool)    theme_light_cool    > "$THEME_FILE" ;;
  light_nature)  theme_light_nature  > "$THEME_FILE" ;;
  *)        exit 1 ;;
esac

echo "Applying theme: $CHOICE"

# ── recompile ────────────────────────────────────────────────────────────────
for dir in "$ST_DIR" "$DWM_DIR" "$DMENU_DIR" "$TABBED_DIR"; do
  echo "Building $(basename $dir)..."
  cd "$dir" && sudo make clean install
done

echo "Done. Restart dwm to apply :D"
notify-send "Done"
