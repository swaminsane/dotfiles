#!/bin/sh

# Source environment too
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# Caps Lock as Escape
setxkbmap -option caps:escape &
# setxkbmap -option caps:ctrl_modifier &

# screen timeout
xset s 600 600
xset dpms 630 630 630
xss-lock slock &

# Only run these in dwm
if [ "$WM" = "dwm" ]; then
    dwmblocks &
    xsct 4200 &
    dunst &
    picom &
    feh --bg-fill --randomize $HOME/.local/share/wallpapers/
    nm-applet &
    /usr/bin/kdeconnectd &
fi

# Only run these in muhhwm
if [ "$WM" = "muhhwm" ]; then
    dwmblocks &
    xsct 4200 &
    dunst &
    picom &
    feh --bg-fill --randomize $HOME/.local/share/wallpapers/
    nm-applet &
    /usr/bin/kdeconnectd &
fi
